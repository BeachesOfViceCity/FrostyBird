+        pthread_mutex_unlock(&s->lock);
+        return S_OK;
+    }
+    pthread_mutex_unlock(&s->lock);
+    hr = vkd3d_allocate_heap_memory(device, &device->memory_allocator, info, allocation);
+    if (SUCCEEDED(hr) && allocation->chunk)
+    {
+        pthread_mutex_lock(&s->lock);
+        ++s->misses;
