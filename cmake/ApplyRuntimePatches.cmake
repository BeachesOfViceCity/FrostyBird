# Only invoked for pinned, superbuild-owned upstream sources.
function(apply_patch tree name)
    get_filename_component(parent "${tree}" DIRECTORY)
    set(apply "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${parent}"
        "${GIT}" -C "${tree}" apply)
    set(file "${CMAKE_CURRENT_LIST_DIR}/../patches/${name}")
    execute_process(COMMAND ${apply} --check "${file}" RESULT_VARIABLE forward ERROR_QUIET)
    if(forward EQUAL 0)
        execute_process(COMMAND ${apply} "${file}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND ${apply} --reverse --check "${file}" RESULT_VARIABLE applied ERROR_QUIET)
        if(NOT applied EQUAL 0)
            message(FATAL_ERROR "${name} does not match the pinned source in ${tree}")
        endif()
    endif()
endfunction()

if(COMPONENT STREQUAL "wine")
    apply_patch("${SOURCE}" wine-runtime.patch)
    apply_patch("${SOURCE}" wine-mapped-dualsense.patch)
elseif(COMPONENT STREQUAL "vkd3d")
    apply_patch("${SOURCE}" vkd3d-runtime.patch)
    apply_patch("${SOURCE}" vkd3d-installer-cache.patch)
    apply_patch("${SOURCE}/subprojects/dxil-spirv" dxil-spirv-subgroup.patch)
else()
    message(FATAL_ERROR "Unknown patched component: ${COMPONENT}")
endif()
